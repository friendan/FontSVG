#include "resource.h"
#include "AppVersion.h"

IDI_FONTSVG ICON "App.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FONTSVG_VERSION_MAJOR,FONTSVG_VERSION_MINOR,FONTSVG_VERSION_PATCH,FONTSVG_VERSION_BUILD
 PRODUCTVERSION FONTSVG_VERSION_MAJOR,FONTSVG_VERSION_MINOR,FONTSVG_VERSION_PATCH,FONTSVG_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "FontSVG"
            VALUE "FileDescription", "FontSVG - Font to SVG Converter"
            VALUE "FileVersion", FONTSVG_VERSION_STR_A
            VALUE "InternalName", "FontSVG"
            VALUE "LegalCopyright", "Copyright (C) FontSVG"
            VALUE "OriginalFilename", "FontSVG.exe"
            VALUE "ProductName", "FontSVG"
            VALUE "ProductVersion", FONTSVG_VERSION_STR_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
